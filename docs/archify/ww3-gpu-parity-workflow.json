  "cards": [
    {
      "dot": "cyan",
      "title": "CPU rule",
      "items": [
        "Bit for bit with the Fortran of the same executable: test.comp finding a file different fails the entry",
        "Only files that two Fortran runs already write differently (ww3_self) are excused",
        "nccmp-tol FAIL also fails; its PASS never excuses a byte difference"
      ]
    },
    {
      "dot": "rose",
      "title": "GPU rule (ADR-0014)",
      "items": [
        "CUDA verdict is nccmp-tol with tolerances.txt, against the Fortran and --ww3",
        "Its timing record says: GPU: judged by tolerance, not bits",
        "Runs only under the owner; none has been recorded yet"
      ]
    },
    {
      "dot": "amber",
      "title": "Timing",
      "items": [
        "Only bench/results/ record is the 2026-09-15 kernel study, kept under the older l1 rule",
        "No end-to-end ww3-gpu speed figure has passed this workflow yet"
      ]
    }
