  "cards": [
    {
      "dot": "cyan",
      "title": "ww3-gpu: three runtimes",
      "items": [
        "1 --ww3: pure NOAA WW3 from WW3-noaa/, the reference",
        "2 --ww3-gpu: the fork with the KOKKOS switch, linked to kokkos/; each routine runs in Fortran or Kokkos by a flag",
        "3 --ww4: WAVEWATCH IV from its fork; it stops with exit 5 when a part the case needs is not ported"
      ]
    },
    {
      "dot": "emerald",
      "title": "chaceon: a fourth runtime",
      "items": [
        "4 --chaceon: WW3 rewritten in Rust (a planned flag of scripts/ww3-gpu.sh); no Fortran runs in its process",
        "Compiled for the CPU, for SPIR-V (rust-gpu) and for PTX (Rust-CUDA)",
        "Its reference is MetOcean WW3 7.14, compiled separately"
      ]
    },
    {
      "dot": "rose",
      "title": "Pins",
      "items": [
        "Today ww3-gpu pins NOAA WW3 03adda91 and chaceon pins WW3 7.14",
        "Next step: every runtime moves to WW3 7.14",
        "No runtime has run the whole model on a real GPU"
      ]
    }
  ]
