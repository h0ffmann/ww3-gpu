  "cards": [
    {
      "dot": "cyan",
      "title": "One command, six runtimes",
      "items": [
        "1 --ww3: MetOcean WW3 7.14 (metocean/WW3 92e2cf66), Fortran, the reference every other runtime must give the bits of",
        "2, 3 --ww3-gpu with --cpu or --gpu: the fork with the KOKKOS switch, linked to kokkos/",
        "4, 5 --chaceon (alias --cceon) with --cpu or --gpu: WW3 rewritten in Rust, no Fortran in its process",
        "6 --ww4: WAVEWATCH IV, when it is released"
      ]
    },
    {
      "dot": "rose",
      "title": "Not yet true of the script",
      "items": [
        "--ww3-gpu is compared with --ww3-noaa (NOAA WW3 03adda91, the base of its fork) until the fork is moved onto MetOcean WW3 7.14",
        "--chaceon --gpu stops with exit 5: nothing of chaceon has run on a real GPU",
        "--ww4 stops with exit 5 while the case needs a part that is not ported to WW4",
        "No runtime has run the whole model on a real GPU"
      ]
    }
