    { "dot": "cyan", "title": "Same", "items": [
      "Fortran physics: the fork is WW3-noaa plus the KOKKOS patch, checked by diff before --ww3 builds",
      "Lab switch (switch_lab_ompg by default), CMake Release, pinned pratico toolchain",
      "Every WW_KOKKOS_<PART> unset or 0 runs the Fortran routine in the ww3-gpu binary"
    ] },
    { "dot": "emerald", "title": "Differs", "items": [
      "KOKKOS switch adds w3kokkosmd.F90 and #ifdef W3_KOKKOS branches at the call sites",
      "-DWW_KOKKOS=ON links libww_kokkos through bind(C) shims",
      "A flag set to 1 sends that part to Kokkos; WW_KOKKOS_ALL=1 sends every wired part"
    ] },
    { "dot": "rose", "title": "GPU", "items": [
      "CUDA backend only for --ww3-gpu; --ww3 --gpu is refused (exit 64)",
      "--gpu runs only after the owner types yes at a terminal (exit 7 otherwise)",
      "Device math: ww::libm copies of glibc with WW_KOKKOS_LIBM; device bits not yet compared on a GPU (unverified)"
    ] }
