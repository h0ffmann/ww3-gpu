  "cards": [
    {
      "dot": "cyan",
      "title": "Um comando, seis runtimes",
      "items": [
        "1 --ww3: o WW3 7.14 da MetOcean (WW3-metocean/, 92e2cf66), Fortran, a referência cujos bits os outros runtimes precisam dar",
        "2, 3 --ww3-gpu com --cpu ou --gpu: o fork com a chave KOKKOS, ligado a kokkos/",
        "4, 5 --chaceon (ou --cceon) com --cpu ou --gpu: o WW3 reescrito em Rust, sem Fortran no processo",
        "6 --ww4: o WAVEWATCH IV, quando for lançado"
      ]
    },
    {
      "dot": "rose",
      "title": "Ainda não vale no script",
      "items": [
        "--ww3-gpu é comparado com --ww3-noaa (o WW3 da NOAA em 03adda91, a base do fork) até o fork passar para o WW3 7.14 da MetOcean",
        "--chaceon --gpu para com código 5: nada do chaceon rodou em uma GPU real",
        "--ww4 para com código 5 enquanto o caso precisar de uma parte não portada para o WW4",
        "Nenhum runtime rodou o modelo inteiro em uma GPU real"
      ]
    }
