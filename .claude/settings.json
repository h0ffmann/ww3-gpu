{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/proposal-review.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/proposal-review-stop.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/kokkos-account.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ai-memory@ai-memory": true
  },
  "extraKnownMarketplaces": {
    "ai-memory": {
      "source": {
        "source": "github",
        "repo": "akitaonrails/ai-memory",
        "ref": "v3.0.0"
      }
    }
  }
}
