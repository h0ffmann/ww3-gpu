# One entry of the matrix (cmake -DCONFIG=<ww3gpu_config.cmake> -DN=<n> -DTEST=<test> -DOPTS=<options>
# -P run_entry.cmake): run_cmake_test twice from <build>/regtests with path_build_root shared,
# every WW_KOKKOS_<R>=0 into work_F_<n> and WW_KOKKOS_<R>=1 for each R of WW3GPU_ROUTINES into
# work_K_<n>; then WW3's test.comp on the pair and nccmp-tol on every ww3.*.nc both wrote. Writes
# <build>/rows/<n>.tsv (the columns of summary.tsv) and fails per ww3gpu_row_verdict. -DDRY_RUN=ON
# prints the commands and runs none. WW3GPU_OMP_NESTED=ON exports OMP_MAX_ACTIVE_LEVELS=2 for both
# runs (regtests/CMakeLists.txt). The Kokkos run sets WW_KOKKOS_<U>_COUNT=1 for every U of
# WW3GPU_COUNT_FLAGS: every process prints the spectra (FLX: points) each Kokkos routine computed to
# stderr at exit; the row's kokkos_spectra is their sum for one routine, <R>:<sum>,... for several. A
# routine counts only when the entry's switch builds it (ww3gpu_routine_word). When test.comp finds a file
# different, the Fortran run is repeated into work_G_<n>: a file that two Fortran runs of the same
# executable already write differently is WW3's own run-to-run variation (ww3_self), and only a
# file that differs Fortran/Kokkos and is identical Fortran/Fortran counts in test_comp. Under
# WW3GPU_KOKKOS the Kokkos run takes that preset's flags instead (ww3gpu_kokkos_env), kokkos_log
# is W3INIT's parts line showing each part on Kokkos, and kokkos_spectra lists every
# "W3<R> spectra|points computed" counter. Every run sets WW_KOKKOS_ALL and unsets the parts it
# does not turn on, so no flag is inherited from the shell. The Kokkos run also sets
# WW_KOKKOS_STRICT=1: a part it asks for that would run the Fortran stops it, so a
# pair never compares the Fortran with itself unseen (kokkos/src/fortran_iface/PATCH.md section
# 24). Every Kokkos run sets WW_KOKKOS_VA_POISON=1 (section 21) unless the caller's environment
# has WW_KOKKOS_VA_POISON=0; the Fortran runs never have it.
cmake_minimum_required(VERSION 3.21)
include("${CONFIG}")
include("${CMAKE_CURRENT_LIST_DIR}/ww3gpu_common.cmake")
ww3gpu_require_gpu_confirmation()
# Read once, before run() rewrites the environment of the runs.
if("$ENV{WW_KOKKOS_VA_POISON}" STREQUAL "0")
  set(WW3GPU_VA_POISON 0)
endif()

# Not string(TIMESTAMP): it honours SOURCE_DATE_EPOCH, which the Nix shell sets to 1980.
execute_process(COMMAND date +%s OUTPUT_VARIABLE t0 OUTPUT_STRIP_TRAILING_WHITESPACE)
ww3gpu_words(o "${OPTS}")
ww3gpu_opt_of(sw -s ${o})
ww3gpu_opt_of(inp -i ${o})
ww3gpu_opt_of(oo -o ${o})
if(sw STREQUAL "")
  set(swname default)
else()
  set(swname "${sw}")
endif()
if(inp STREQUAL "")
  set(inp input)
endif()
# The routines of WW3GPU_ROUTINES the entry's switch builds: their log line and count are asked for.
if(sw STREQUAL "")
  set(swf "${WW3GPU_WW3}/regtests/${TEST}/${inp}/switch")
else()
  set(swf "${WW3GPU_WW3}/regtests/${TEST}/${inp}/switch_${sw}")
endif()
set(active "")
if(WW3GPU_KOKKOS STREQUAL "")
  set(kflags "${WW3GPU_ROUTINES}")
else()
  set(kflags "${WW3GPU_FLAGS}")
endif()
foreach(r IN LISTS WW3GPU_ROUTINES)
  if(NOT WW3GPU_KOKKOS STREQUAL "")
    break()
  endif()
  ww3gpu_routine_word(w "${r}")
  ww3gpu_has_word(has "${swf}" "${w}")
  if(has)
    list(APPEND active "${r}")
  endif()
endforeach()
set(wf "${WW3GPU_STAGE}/${TEST}/work_F_${N}")
set(wk "${WW3GPU_STAGE}/${TEST}/work_K_${N}")
set(log "${WW3GPU_OUT}/logs/${N}")
set(rowf "${WW3GPU_OUT}/rows/${N}.tsv")

set(ENV{CMAKE_OPTIONS} "-DWW_KOKKOS=ON -DCMAKE_PREFIX_PATH=${WW3GPU_KPREFIX}")
# Kokkos' CUDA package wants the compiler it was built with, as scripts/ww3-gpu.sh passes it.
if(WW3GPU_BACKEND STREQUAL "cuda")
  set(ENV{CMAKE_OPTIONS} "$ENV{CMAKE_OPTIONS} -DCMAKE_CXX_COMPILER=nvcc_wrapper")
endif()
set(ENV{path_build_root} "${WW3GPU_OUT}/build_${N}")
if(NOT DEFINED WW3GPU_MPI_RANKS)
  set(WW3GPU_MPI_RANKS 4)
endif()
# An MPI line shares the entry's threads among its ranks, the Kokkos OpenMP backend of each rank
# included, so a job uses about WW3GPU_OMP_THREADS cores whatever its kind.
set(thr "${WW3GPU_OMP_THREADS}")
if("-p" IN_LIST o)
  math(EXPR thr "${WW3GPU_OMP_THREADS} / ${WW3GPU_MPI_RANKS}")
  if(thr LESS 1)
    set(thr 1)
  endif()
endif()
set(ENV{OMP_NUM_THREADS} "${thr}")
if(NOT DEFINED ENV{OMP_PROC_BIND})
  set(ENV{OMP_PROC_BIND} false)
endif()
if(WW3GPU_OMP_NESTED)
  set(ENV{OMP_MAX_ACTIVE_LEVELS} 2)
endif()

if(DRY_RUN)
  foreach(k F K)
    ww3gpu_entry_args(a ${N} ${k} "${TEST}" "${OPTS}" "${WW3GPU_WW3}" "${thr}" "${WW3GPU_MPI_RANKS}")
    list(JOIN a " " a)
    ww3gpu_kokkos_env(env ${k} "${kflags}" "${WW3GPU_ENV_PARTS}" "${WW3GPU_ENV_COUNTS}")
    set(fl "")
    foreach(kv IN LISTS env)
      if(kv MATCHES "=$")
        string(APPEND fl "-u ${kv} ")
      else()
        string(APPEND fl "${kv} ")
      endif()
    endforeach()
    string(REPLACE "= " " " fl "${fl}")
    message("CMAKE_OPTIONS='$ENV{CMAKE_OPTIONS}' ${fl}path_build_root=$ENV{path_build_root} ${WW3GPU_WW3}/regtests/bin/run_cmake_test ${a}")
  endforeach()
  message("${WW3GPU_WW3}/regtests/bin/test.comp ${TEST} work_F_${N} work_K_${N}; ${WW3GPU_NCCMP} work_F_${N}/ww3.*.nc work_K_${N}/ww3.*.nc ${WW3GPU_TOLS}")
  return()
endif()

file(REMOVE_RECURSE "${wf}" "${wk}")
# A build_<n> configured by another toolchain (a picasso bump) is rebuilt from scratch: its
# CMake cache keeps the old compilers, and they link the new libraries against the old glibc.
find_program(_gf gfortran)
find_program(_cxx c++)
file(REAL_PATH "${_gf}" _gf)
file(REAL_PATH "${_cxx}" _cxx)
set(_tc "${_gf} ${_cxx} ${WW3GPU_KPREFIX}")
set(_tcf "${WW3GPU_OUT}/build_${N}.toolchain")
set(_old "")
if(EXISTS "${_tcf}")
  file(READ "${_tcf}" _old)
endif()
if(NOT _old STREQUAL _tc)
  file(GLOB _stale LIST_DIRECTORIES true "${WW3GPU_OUT}/build_${N}" "${WW3GPU_OUT}/build_${N}_*")
  file(REMOVE_RECURSE ${_stale})
endif()
file(WRITE "${_tcf}" "${_tc}")
file(GLOB old "${log}.*")
if(old)
  file(REMOVE ${old})
endif()
file(MAKE_DIRECTORY "${WW3GPU_OUT}/rows" "${WW3GPU_OUT}/logs")
# A placeholder, so an entry killed before its end still has a row.
file(WRITE "${rowf}" "${N}\t${TEST}\t${swname}\tno\tno\tno\tn/a\tn/a\t-\t0\t0\t-\t${OPTS}\n")

# run(<F|K|G>): one run of the entry; F and G with the Fortran, K with the Kokkos routines of
# WW3GPU_ROUTINES or the flags of WW3GPU_KOKKOS.
function(run k)
  ww3gpu_kokkos_env(env ${k} "${kflags}" "${WW3GPU_ENV_PARTS}" "${WW3GPU_ENV_COUNTS}")
  foreach(kv IN LISTS env)
    string(REGEX MATCH "^[^=]+" name "${kv}")
    string(REGEX REPLACE "^[^=]+=" "" val "${kv}")
    if(val STREQUAL "")
      unset(ENV{${name}})
    else()
      set(ENV{${name}} "${val}")
    endif()
  endforeach()
  ww3gpu_entry_args(a ${N} ${k} "${TEST}" "${OPTS}" "${WW3GPU_WW3}" "${thr}" "${WW3GPU_MPI_RANKS}")
  execute_process(COMMAND "${WW3GPU_WW3}/regtests/bin/run_cmake_test" ${a}
                  WORKING_DIRECTORY "${WW3GPU_STAGE}"
                  OUTPUT_FILE "${log}.${k}.log" ERROR_FILE "${log}.${k}.log" RESULT_VARIABLE rc)
endfunction()
# compare(<prefix> <a> <b>): test.comp on work_<a>_<n> and work_<b>_<n>; <prefix>_DIFF the files
# it finds different, <prefix>_N the files it compared.
function(compare prefix x y)
  execute_process(COMMAND "${WW3GPU_WW3}/regtests/bin/test.comp" "${TEST}" "work_${x}_${N}" "work_${y}_${N}"
                  WORKING_DIRECTORY "${WW3GPU_STAGE}"
                  OUTPUT_FILE "${log}.test_comp.${x}${y}.log" ERROR_FILE "${log}.test_comp.${x}${y}.log")
  file(STRINGS "${log}.test_comp.${x}${y}.log" d REGEX " is different$")
  file(STRINGS "${log}.test_comp.${x}${y}.log" s REGEX " is identical$")
  list(LENGTH d nd)
  list(LENGTH s ni)
  math(EXPR nt "${nd} + ${ni}")
  set(${prefix}_DIFF "${d}" PARENT_SCOPE)
  set(${prefix}_N "${nt}" PARENT_SCOPE)
endfunction()

file(REMOVE_RECURSE "${WW3GPU_STAGE}/${TEST}/work_G_${N}")
run(F)
run(K)

# hit(<out> <regex> <file>...): a line of one of the files matches.
function(hit out re)
  foreach(f IN LISTS ARGN)
    if(EXISTS "${f}")
      file(STRINGS "${f}" m REGEX "${re}")
      if(m)
        set(${out} TRUE PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  set(${out} FALSE PARENT_SCOPE)
endfunction()

set(built no)
if(EXISTS "${wf}/exe/ww3_shel")
  set(built yes)
endif()
# ww3_shel, or ww3_multi for an entry with -m.
hit(rf "End of program" "${wf}/ww3_shel.out" "${wf}/ww3_multi.out")
hit(rk "End of program" "${wk}/ww3_shel.out" "${wk}/ww3_multi.out")
if(rf AND rk)
  set(ran yes)
elseif(rf)
  set(ran fortran-only)
elseif(rk)
  set(ran kokkos-only)
else()
  set(ran no)
endif()
file(GLOB klogs "${wk}/log.*" "${wk}/ww3_shel.out" "${wk}/ww3_multi.out")
# W3INIT's log line of each active routine (the fork's w3initmd.F90, ww3gpu_routine_log).
set(klog yes)
foreach(r IN LISTS active)
  ww3gpu_routine_log(re "${r}")
  hit(k "${re}" ${klogs})
  if(NOT k)
    set(klog no)
  endif()
endforeach()
# Under WW3GPU_KOKKOS: every part of the preset is K in a parts line of the Kokkos run (W3INIT
# writes one per set-up; ww3_multi one per grid, each must show it).
if(NOT WW3GPU_KOKKOS STREQUAL "")
  set(plines "")
  foreach(f IN LISTS klogs)
    file(STRINGS "${f}" m REGEX "Kokkos parts \\(K Kokkos, F Fortran\\):")
    list(APPEND plines ${m})
  endforeach()
  set(miss "")
  foreach(l IN LISTS plines)
    ww3gpu_parts_line_check(x "${l}" "${WW3GPU_FLAGS}")
    if(NOT x STREQUAL "")
      list(APPEND miss "${x}")
    endif()
  endforeach()
  if(NOT plines OR miss)
    set(klog no)
    list(REMOVE_DUPLICATES miss)
    list(JOIN miss "," miss)
    file(WRITE "${log}.parts_missing.log" "parts not on Kokkos in the Kokkos run: ${miss}\n")
  endif()
endif()
set(spectra "")
foreach(r IN LISTS active)
  set(c 0)
  if(EXISTS "${log}.K.log")
    file(STRINGS "${log}.K.log" cl REGEX "^ww_kokkos: W3${r} (spectra|points) computed: [0-9]+$")
    foreach(l IN LISTS cl)
      string(REGEX REPLACE ".*: " "" v "${l}")
      math(EXPR c "${c} + ${v}")
    endforeach()
  endif()
  list(LENGTH WW3GPU_ROUTINES nr)
  if(nr EQUAL 1)
    set(spectra "${c}")
  else()
    list(APPEND spectra "${r}:${c}")
  endif()
endforeach()
if(NOT WW3GPU_KOKKOS STREQUAL "" AND EXISTS "${log}.K.log")
  file(STRINGS "${log}.K.log" cl REGEX "^ww_kokkos: W3[A-Z0-9]+ (spectra|points) computed: [0-9]+$")
  set(names "")
  foreach(l IN LISTS cl)
    string(REGEX REPLACE "^ww_kokkos: W3([A-Z0-9]+) .*: ([0-9]+)$" "\\1;\\2" nv "${l}")
    list(GET nv 0 nm)
    list(GET nv 1 v)
    if(NOT nm IN_LIST names)
      list(APPEND names "${nm}")
      set(sum_${nm} 0)
    endif()
    math(EXPR sum_${nm} "${sum_${nm}} + ${v}")
  endforeach()
  foreach(nm IN LISTS names)
    list(APPEND spectra "${nm}:${sum_${nm}}")
  endforeach()
endif()
if(spectra STREQUAL "")
  set(spectra 0)
endif()
list(JOIN spectra "," spectra)

set(tc n/a)
set(self -)
set(nv n/a)
set(judged "")
if(ran STREQUAL "yes")
  compare(FK F K)
  set(port "${FK_DIFF}")
  if(FK_DIFF)
    run(G)
    if(EXISTS "${WW3GPU_STAGE}/${TEST}/work_G_${N}")
      compare(FG F G)
      list(LENGTH FG_DIFF ng)
      set(self "${ng}/${FG_N}")
      if(FG_DIFF)
        list(REMOVE_ITEM port ${FG_DIFF})
      endif()
    endif()
  endif()
  list(LENGTH port nport)
  set(tc "${nport}/${FK_N}")
  file(WRITE "${log}.test_comp.port.log" "")
  foreach(l IN LISTS port)
    file(APPEND "${log}.test_comp.port.log" "${l}\n")
  endforeach()

  file(WRITE "${log}.nccmp.log" "")
  # Recursive: ww3_multi's ww3_ounf writes one directory per grid (work/ww3_ounf_<grid>/).
  file(GLOB_RECURSE ncs RELATIVE "${wf}" "${wf}/ww3.*.nc")
  list(SORT ncs)
  set(nc 0)
  foreach(f IN LISTS ncs)
    if(NOT EXISTS "${wk}/${f}")
      continue()
    endif()
    math(EXPR nc "${nc} + 1")
    execute_process(COMMAND "${WW3GPU_NCCMP}" "${wf}/${f}" "${wk}/${f}" "${WW3GPU_TOLS}"
                    OUTPUT_VARIABLE out ERROR_VARIABLE out RESULT_VARIABLE rc)
    string(REPLACE "/" "_" fo "${f}")
    file(WRITE "${log}.nccmp.${fo}.out" "${out}")
    file(APPEND "${log}.nccmp.log" "== ${f}\n${out}")
    ww3gpu_judged_vars(j "${out}")
    if(NOT rc EQUAL 0)
      set(nv FAIL)
    elseif(NOT j STREQUAL "" AND NOT nv STREQUAL "FAIL")
      set(nv PASS)
    endif()
    if(NOT j STREQUAL "")
      string(REPLACE "," ";" j "${j}")
      list(APPEND judged ${j})
    endif()
  endforeach()
  ww3gpu_has_ounf(ounf "${WW3GPU_WW3}/regtests/${TEST}/${inp}")
  if(nc EQUAL 0 AND ounf AND NOT oo STREQUAL "native")
    set(nv MISSING)
  endif()
endif()
if(judged)
  list(REMOVE_DUPLICATES judged)
  list(SORT judged)
  list(JOIN judged "," judged)
else()
  set(judged -)
endif()

execute_process(COMMAND date +%s OUTPUT_VARIABLE t1 OUTPUT_STRIP_TRAILING_WHITESPACE)
math(EXPR wall "${t1} - ${t0}")
set(row "${N}\t${TEST}\t${swname}\t${built}\t${ran}\t${klog}\t${tc}\t${nv}\t${judged}\t${wall}\t${spectra}\t${self}\t${OPTS}")
file(WRITE "${rowf}" "${row}\n")
message(STATUS "entry ${N} ${TEST} ${swname}: built=${built} ran=${ran} kokkos_log=${klog} test.comp=${tc} nccmp-tol=${nv} kokkos_spectra=${spectra} ww3_self=${self}; logs ${log}.*")
ww3gpu_row_verdict(why "${row}" "${WW3GPU_STRICT}")
if(NOT why STREQUAL "")
  message(FATAL_ERROR "entry ${N} ${TEST} ${swname} fails: ${why}")
endif()
