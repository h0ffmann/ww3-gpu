# The functions the regtest matrix (WFIP-0003) shares between configure, the test scripts and the
# self-test: which matrix.base entries run, the run_cmake_test argument list of an entry, the
# verdict of a row, and the parsing of WW3's ftp script. Every one is exercised on fixtures by
# selftest.cmake.
include_guard(GLOBAL)

# ww3gpu_words(<out> <string>): the whitespace-separated tokens of <string>.
function(ww3gpu_words out s)
  string(REGEX MATCHALL "[^ \t\r\n]+" w "${s}")
  set(${out} "${w}" PARENT_SCOPE)
endfunction()

# ww3gpu_opt_of(<out> <flag> <token>...): the value following the last <flag>, empty when absent.
# The last, as run_cmake_test's option loop keeps it: `-s MPI -s PDLIB` builds switch_PDLIB.
function(ww3gpu_opt_of out flag)
  set(prev "")
  set(v "")
  foreach(f IN LISTS ARGN)
    if("${prev}" STREQUAL "${flag}")
      set(v "${f}")
    endif()
    set(prev "${f}")
  endforeach()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# ww3gpu_expand(<out> <options> <np> <nr> <nth>): matrix.base's shell variables in an entry's
# options, as the matrix would expand them: $mpi -> mpirun, $np, $nr, $nth, then $(( a - b )).
function(ww3gpu_expand out s np nr nth)
  string(REPLACE "$mpi" "mpirun" s "${s}")
  string(REPLACE "$np" "${np}" s "${s}")
  string(REPLACE "$nr" "${nr}" s "${s}")
  string(REPLACE "$nth" "${nth}" s "${s}")
  while(s MATCHES "\\$\\(\\( *([0-9]+) *([-+*/]) *([0-9]+) *\\)\\)")
    math(EXPR v "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3}")
    string(REPLACE "${CMAKE_MATCH_0}" "${v}" s "${s}")
  endwhile()
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

# ww3gpu_has_word(<out> <file> <regex alternation>): grep -qwE on a file (word = [A-Za-z0-9_]).
function(ww3gpu_has_word out file alt)
  file(READ "${file}" s)
  if(s MATCHES "(^|[^A-Za-z0-9_])(${alt})([^A-Za-z0-9_]|$)")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# ww3gpu_routine_word(<out> <routine>): the physics switch a routine of WW3GPU_ROUTINES needs,
# NL1 for SNL1 and ST4 for SDS4, SIN4 and SPR4; empty for any other name.
function(ww3gpu_routine_word out r)
  if(r STREQUAL "SNL1")
    set(${out} NL1 PARENT_SCOPE)
  elseif(r MATCHES "^(SDS4|SIN4|SPR4)$")
    set(${out} ST4 PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

# ww3gpu_physics(<out> <routines>): the physics switches of a routine list, sorted, no duplicate.
function(ww3gpu_physics out)
  set(w "")
  foreach(r IN LISTS ARGN)
    ww3gpu_routine_word(x "${r}")
    list(APPEND w ${x})
  endforeach()
  list(REMOVE_DUPLICATES w)
  list(SORT w)
  set(${out} "${w}" PARENT_SCOPE)
endfunction()

# ww3gpu_select_entries(<prefix> <matrix.base> <regtests dir> <serial|omp|mpi|all> [<physics>]):
# every kept entry, in order, as two parallel lists <prefix>_TESTS and <prefix>_OPTS (the entry's
# options, $ww3 and the test dropped, space-joined). <physics> is a list of switch words, NL1 by
# default; every entry whose switch has one of them is in exactly one of serial (none of MPI,
# OMPG, OMPH), omp (OMPG or OMPH, no MPI) and mpi (MPI); all is the three. A line whose switch
# file is missing is dropped.
function(ww3gpu_select_entries prefix base rt kind)
  set(phys "${ARGV4}")
  if(phys STREQUAL "")
    set(phys NL1)
  endif()
  list(JOIN phys "|" phys)
  file(STRINGS "${base}" lines REGEX "echo \"\\$rtst .*\" *>> *matrix\\.body")
  set(tests "")
  set(optl "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^[ \t]*#")
      continue()
    endif()
    string(REGEX REPLACE ".*echo \"\\$rtst " "" s "${line}")
    string(REGEX REPLACE "\".*" "" s "${s}")
    ww3gpu_words(tok "${s}")
    list(LENGTH tok len)
    if(len LESS 2)
      continue()
    endif()
    list(POP_BACK tok test)
    list(GET tok -1 last)
    if("${last}" STREQUAL "$ww3")
      list(POP_BACK tok)
    endif()
    ww3gpu_opt_of(inp -i ${tok})
    ww3gpu_opt_of(sw -s ${tok})
    if(inp STREQUAL "")
      set(inp input)
    endif()
    set(f "${rt}/${test}/${inp}/switch")
    if(NOT sw STREQUAL "")
      string(APPEND f "_${sw}")
    endif()
    if(NOT EXISTS "${f}" OR IS_DIRECTORY "${f}")
      continue()
    endif()
    ww3gpu_has_word(nl1 "${f}" "${phys}")
    ww3gpu_has_word(mpi "${f}" "MPI")
    ww3gpu_has_word(omp "${f}" "OMPG|OMPH")
    if(NOT nl1)
      continue()
    endif()
    if(mpi)
      set(k mpi)
    elseif(omp)
      set(k omp)
    else()
      set(k serial)
    endif()
    if(NOT kind STREQUAL "all" AND NOT kind STREQUAL k)
      continue()
    endif()
    list(JOIN tok " " opts)
    list(APPEND tests "${test}")
    list(APPEND optl "${opts}")
  endforeach()
  set(${prefix}_TESTS "${tests}" PARENT_SCOPE)
  set(${prefix}_OPTS "${optl}" PARENT_SCOPE)
endfunction()

# ww3gpu_sel_desc(<out> <serial|omp|mpi|all> [<physics>]): the selection rule, for the record's
# header; <physics> as in ww3gpu_select_entries, NL1 by default.
function(ww3gpu_sel_desc out kind)
  set(w "${ARGV2}")
  if(w STREQUAL "")
    set(w NL1)
  endif()
  list(JOIN w " or " w)
  if(kind STREQUAL "omp")
    set(${out} "switch with ${w} and OMPG or OMPH, no MPI; $np = WW3GPU_OMP_THREADS" PARENT_SCOPE)
  elseif(kind STREQUAL "mpi")
    set(${out} "switch with ${w} and MPI; $mpi = mpirun, $np = $nr = WW3GPU_MPI_RANKS, $nth = WW3GPU_OMP_THREADS" PARENT_SCOPE)
  elseif(kind STREQUAL "all")
    set(${out} "every entry whose switch has ${w}" PARENT_SCOPE)
  else()
    set(${out} "switch with ${w}, none of MPI, OMPG, OMPH" PARENT_SCOPE)
  endif()
endfunction()

# ww3gpu_has_ounf(<out> <input dir>): the test post-processes to NetCDF (a ww3_ounf input).
function(ww3gpu_has_ounf out dir)
  file(GLOB g "${dir}/ww3_ounf*")
  if(g)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# ww3gpu_entry_args(<out> <n> <F|K> <test> <opts> <ww3> <threads> [<ranks>]): the run_cmake_test
# argument list of entry <n>'s run: its options without -s and -w, expanded by ww3gpu_expand ($np is
# <ranks> on an MPI line (-p), <threads> otherwise), -o netcdf when it has no -o and its input
# directory has a ww3_ounf input, then -s <sw>_KOKKOS -w work_<F|K>_<n> <ww3>/model <test>.
function(ww3gpu_entry_args out n kind test opts ww3 threads)
  set(ranks "${ARGV7}")
  if(ranks STREQUAL "")
    set(ranks 4)
  endif()
  ww3gpu_words(o "${opts}")
  if("-p" IN_LIST o)
    set(np "${ranks}")
  else()
    set(np "${threads}")
  endif()
  ww3gpu_expand(opts "${opts}" "${np}" "${ranks}" "${threads}")
  ww3gpu_words(o "${opts}")
  ww3gpu_opt_of(sw -s ${o})
  ww3gpu_opt_of(inp -i ${o})
  ww3gpu_opt_of(oo -o ${o})
  set(keep "")
  set(prev "")
  foreach(f IN LISTS o)
    if(f STREQUAL "-s" OR f STREQUAL "-w")
      set(prev "${f}")
      continue()
    endif()
    if(NOT prev STREQUAL "-s" AND NOT prev STREQUAL "-w")
      list(APPEND keep "${f}")
    endif()
    set(prev "${f}")
  endforeach()
  if(inp STREQUAL "")
    set(inp input)
  endif()
  if(oo STREQUAL "")
    ww3gpu_has_ounf(ounf "${ww3}/regtests/${test}/${inp}")
    if(ounf)
      list(APPEND keep -o netcdf)
    endif()
  endif()
  if(sw STREQUAL "")
    set(ks KOKKOS)
  else()
    set(ks "${sw}_KOKKOS")
  endif()
  list(APPEND keep -s "${ks}" -w "work_${kind}_${n}" "${ww3}/model" "${test}")
  set(${out} "${keep}" PARENT_SCOPE)
endfunction()

# ww3gpu_row_verdict(<out> <row> <strict>): the failures of one summary row, empty when it passes.
# A failure: nccmp-tol FAIL or MISSING; either run did not finish, so nothing was compared; the
# Kokkos run without the W3INIT log line of a selected routine its switch builds ("Kokkos DIA
# (W3SNL1) enabled.", "Kokkos ST4 (...) enabled: ... SDS4=T"); under <strict>, a file test.comp found
# different Fortran/Kokkos and identical Fortran/Fortran (run_entry.cmake). A row whose Kokkos
# run computed no spectrum (kokkos_spectra 0, or <R>:0 for a routine: the grid calls GQM,
# IQTYPE <= 0) passes, and the record says it did not exercise that routine.
function(ww3gpu_row_verdict out row strict)
  string(REPLACE "\t" ";" c "${row}")
  list(GET c 4 ran)
  list(GET c 5 klog)
  list(GET c 6 tc)
  list(GET c 7 nv)
  set(why "")
  if(nv STREQUAL "FAIL" OR nv STREQUAL "MISSING")
    list(APPEND why "nccmp-tol ${nv}")
  endif()
  if(ran STREQUAL "fortran-only")
    list(APPEND why "the Kokkos run did not finish")
  elseif(ran STREQUAL "kokkos-only")
    list(APPEND why "the Fortran run did not finish")
  elseif(ran STREQUAL "no")
    list(APPEND why "neither run finished")
  endif()
  if(ran STREQUAL "yes" AND NOT klog STREQUAL "yes")
    list(APPEND why "no Kokkos log line of a selected routine in the Kokkos run")
  endif()
  if(strict AND tc MATCHES "^([0-9]+)/" AND NOT CMAKE_MATCH_1 EQUAL 0)
    list(APPEND why "test.comp: ${tc} files differ (WW3GPU_STRICT)")
  endif()
  list(JOIN why "; " why)
  set(${out} "${why}" PARENT_SCOPE)
endfunction()

# ww3gpu_judged_vars(<out> <nccmp-tol output>): the variables it judged, comma-separated.
function(ww3gpu_judged_vars out text)
  string(REPLACE ";" "," text "${text}")
  string(REPLACE "\n" ";" lines "${text}")
  set(p FALSE)
  set(v "")
  foreach(l IN LISTS lines)
    if(p)
      ww3gpu_words(w "${l}")
      if(w)
        list(GET w 0 first)
        list(GET w -1 lastw)
        if(NOT first STREQUAL "nccmp-tol:" AND NOT lastw STREQUAL "unlisted")
          list(APPEND v "${first}")
        endif()
      endif()
    endif()
    if(l MATCHES "^-+$")
      set(p TRUE)
    endif()
  endforeach()
  list(JOIN v "," v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# ww3gpu_ftp_version(<ver> <url> <ww3_from_ftp.sh>): the data version and the tarball URL it names.
function(ww3gpu_ftp_version ver url script)
  file(STRINGS "${script}" vl REGEX "^ww3ver=")
  list(GET vl 0 vl)
  string(REGEX REPLACE "^ww3ver=" "" v "${vl}")
  file(STRINGS "${script}" ul REGEX "https://ftp\\.emc\\.ncep\\.noaa\\.gov/")
  set(u "")
  if(ul)
    list(GET ul 0 ul)
    string(REGEX MATCH "https://ftp\\.emc\\.ncep\\.noaa\\.gov/[^ \t]*" u "${ul}")
    string(REPLACE "\${ww3ver}" "${v}" u "${u}")
  endif()
  set(${ver} "${v}" PARENT_SCOPE)
  set(${url} "${u}" PARENT_SCOPE)
endfunction()

# ww3gpu_ftp_copies(<prefix> <ww3_from_ftp.sh>): <prefix>_SRC and <prefix>_DST, the parallel lists
# of every `cp -r data_regtests/<src> regtests/<dst>` line (commented lines excluded).
function(ww3gpu_ftp_copies prefix script)
  file(STRINGS "${script}" lines REGEX "^[ \t]*cp -r data_regtests/")
  set(src "")
  set(dst "")
  foreach(l IN LISTS lines)
    if(l MATCHES "^[ \t]*cp -r data_regtests/([^ \t]+)[ \t]+regtests/([^ \t]+)[ \t]*$")
      list(APPEND src "${CMAKE_MATCH_1}")
      list(APPEND dst "${CMAKE_MATCH_2}")
    endif()
  endforeach()
  set(${prefix}_SRC "${src}" PARENT_SCOPE)
  set(${prefix}_DST "${dst}" PARENT_SCOPE)
endfunction()

# ww3gpu_stage_data(<out count> <cache data_regtests> <stage> <test> <ww3_from_ftp.sh>): copy what
# the script's cp lines copy into regtests/<test>/, for that test only; <out> is the number of
# sources copied, or -1 (nothing copied) when the test needs the data and the cache is missing.
function(ww3gpu_stage_data out cache st test script)
  ww3gpu_ftp_copies(cp "${script}")
  set(n 0)
  set(i 0)
  foreach(src IN LISTS cp_SRC)
    list(GET cp_DST ${i} dst)
    math(EXPR i "${i} + 1")
    string(REGEX REPLACE "/.*" "" top "${dst}")
    if(NOT top STREQUAL test)
      continue()
    endif()
    if(NOT IS_DIRECTORY "${cache}")
      set(${out} -1 PARENT_SCOPE)
      return()
    endif()
    set(to "${st}/${dst}")
    if(dst MATCHES "/$")
      file(MAKE_DIRECTORY "${to}")
    else()
      get_filename_component(d "${to}" DIRECTORY)
      file(MAKE_DIRECTORY "${d}")
    endif()
    file(GLOB fs LIST_DIRECTORIES true "${cache}/${src}")
    foreach(f IN LISTS fs)
      if(IS_DIRECTORY "${to}")
        file(COPY "${f}" DESTINATION "${to}")
      elseif(IS_DIRECTORY "${f}")
        file(COPY "${f}/" DESTINATION "${to}")
      else()
        file(COPY_FILE "${f}" "${to}")
      endif()
      math(EXPR n "${n} + 1")
    endforeach()
  endforeach()
  set(${out} ${n} PARENT_SCOPE)
endfunction()
