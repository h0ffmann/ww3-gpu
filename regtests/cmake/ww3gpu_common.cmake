# The functions the regtest matrix (WFIP-0003) shares between configure, the test scripts and the
# self-test: which matrix.base entries run, the run_cmake_test argument list of an entry, the
# verdict of a row, and the parsing of WW3's ftp script. Every one is exercised on fixtures by
# selftest.cmake.
include_guard(GLOBAL)

# ww3gpu_words(<out> <string>): the whitespace-separated tokens of <string>.
function(ww3gpu_words out s)
  string(REGEX MATCHALL "[^ \t\r\n]+" w "${s}")
  set(${out} "${w}" PARENT_SCOPE)
endfunction()

# ww3gpu_opt_of(<out> <flag> <token>...): the value following the last <flag>, empty when absent.
# The last, as run_cmake_test's option loop keeps it: `-s MPI -s PDLIB` builds switch_PDLIB.
function(ww3gpu_opt_of out flag)
  set(prev "")
  set(v "")
  foreach(f IN LISTS ARGN)
    if("${prev}" STREQUAL "${flag}")
      set(v "${f}")
    endif()
    set(prev "${f}")
  endforeach()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# ww3gpu_expand(<out> <options> <np> <nr> <nth>): matrix.base's shell variables in an entry's
# options, as the matrix would expand them: $mpi -> mpirun, $np, $nr, $nth, then $(( a - b )).
function(ww3gpu_expand out s np nr nth)
  string(REPLACE "$mpi" "mpirun" s "${s}")
  string(REPLACE "$np" "${np}" s "${s}")
  string(REPLACE "$nr" "${nr}" s "${s}")
  string(REPLACE "$nth" "${nth}" s "${s}")
  while(s MATCHES "\\$\\(\\( *([0-9]+) *([-+*/]) *([0-9]+) *\\)\\)")
    math(EXPR v "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3}")
    string(REPLACE "${CMAKE_MATCH_0}" "${v}" s "${s}")
  endwhile()
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

# ww3gpu_has_word(<out> <file> <regex alternation>): grep -qwE on a file (word = [A-Za-z0-9_]).
function(ww3gpu_has_word out file alt)
  file(READ "${file}" s)
  if(s MATCHES "(^|[^A-Za-z0-9_])(${alt})([^A-Za-z0-9_]|$)")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# Every routine WW3GPU_ROUTINES may name: the R of a WW_KOKKOS_<R> flag of the fork's W3KOKKOSMD.
set(WW3GPU_ALL_ROUTINES SNL1 SDS4 SIN4 SPR4 SPR0 SPR1 SIN1 SDS1 SPR2 SIN2 SDS2 SPR3 SIN3 SDS3
    SPR6 SIN6 SDS6 SWL6 FLX1 FLX2 FLX3 FLX4 FLX5)
# The WW_KOKKOS_<U>_COUNT flags: each shim prints its routines' counts at exit when its flag is 1.
set(WW3GPU_COUNT_FLAGS SNL1 ST4 ST0 ST1 ST2 ST3 ST6 SWL FLX)

# ww3gpu_parts_d(<parts> <counts> <dir>): the PART names and COUNT variables of <dir>/*.txt, the
# registry scripts/ww3-gpu.sh reads (kokkos/src/fortran_iface/parts.d, PATCH.md section 9); FILE
# lines and # comments are skipped, any other line stops configure.
function(ww3gpu_parts_d parts counts dir)
  file(GLOB fs "${dir}/*.txt")
  list(SORT fs)
  if(NOT fs)
    message(FATAL_ERROR "ww3gpu_matrix: no ${dir}/*.txt")
  endif()
  set(p "")
  set(c "")
  foreach(f IN LISTS fs)
    file(STRINGS "${f}" lines)
    foreach(l IN LISTS lines)
      if(l MATCHES "^[ \t]*(#|$)" OR l MATCHES "^FILE ")
        continue()
      elseif(l MATCHES "^PART ([A-Z][A-Z0-9_]*)$")
        list(APPEND p "${CMAKE_MATCH_1}")
      elseif(l MATCHES "^COUNT (WW_KOKKOS_[A-Z0-9_]+_COUNT)$")
        list(APPEND c "${CMAKE_MATCH_1}")
      else()
        message(FATAL_ERROR "ww3gpu_matrix: ${f}: unknown line '${l}'")
      endif()
    endforeach()
  endforeach()
  set(${parts} "${p}" PARENT_SCOPE)
  set(${counts} "${c}" PARENT_SCOPE)
endfunction()

# The presets of WW_KOKKOS_PRESET (PATCH.md section 25), the file the shim compiles and
# scripts/ww3-gpu.sh reads; WW3GPU_PRESETS_TXT may point elsewhere (selftest.cmake).
if(NOT DEFINED WW3GPU_PRESETS_TXT)
  set(WW3GPU_PRESETS_TXT "${CMAKE_CURRENT_LIST_DIR}/../../kokkos/src/fortran_iface/presets.txt")
endif()

# ww3gpu_preset_parts(<out> <name>): the PART,... list of PRESET <name> in WW3GPU_PRESETS_TXT, or
# empty when the file has no such preset.
function(ww3gpu_preset_parts out name)
  set(r "")
  if(EXISTS "${WW3GPU_PRESETS_TXT}")
    file(STRINGS "${WW3GPU_PRESETS_TXT}" lines REGEX "^PRESET ")
    foreach(l IN LISTS lines)
      if(l MATCHES "^PRESET ([a-z][a-z0-9_]*) ([A-Z][A-Z0-9_]*(,[A-Z][A-Z0-9_]*)*)$" AND CMAKE_MATCH_1 STREQUAL name)
        set(r "${CMAKE_MATCH_2}")
        break()
      endif()
    endforeach()
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ww3gpu_kokkos_preset(<out> <spec> <parts>): the flags the Kokkos run of WW3GPU_KOKKOS sets, as
# scripts/ww3-gpu.sh --kokkos does: "all" is ALL (WW_KOKKOS_ALL=1), a preset of presets.txt
# (resident) its part list, "none" nothing, and a comma list its parts, each of <parts>; <out> is
# ERROR:<why> for anything else.
function(ww3gpu_kokkos_preset out spec parts)
  if(spec STREQUAL "all")
    set(${out} ALL PARENT_SCOPE)
    return()
  elseif(spec STREQUAL "none")
    set(${out} "" PARENT_SCOPE)
    return()
  elseif(spec MATCHES "^[a-z][a-z0-9_]*$")
    ww3gpu_preset_parts(pl "${spec}")
    if(pl STREQUAL "")
      set(${out} "ERROR:'${spec}' is not a preset of ${WW3GPU_PRESETS_TXT}" PARENT_SCOPE)
      return()
    endif()
    set(spec "${pl}")
  endif()
  string(REPLACE "," ";" l "${spec}")
  if(l STREQUAL "")
    set(${out} "ERROR:empty" PARENT_SCOPE)
    return()
  endif()
  foreach(p IN LISTS l)
    if(NOT p IN_LIST parts)
      set(${out} "ERROR:'${p}' is not all, none, resident or a part of parts.d" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "${l}" PARENT_SCOPE)
endfunction()

# ww3gpu_kokkos_env(<out> <F|K|G> <flags> <parts> <counts>): the environment of one run, a list of
# NAME=VALUE, NAME= meaning unset. Every WW_KOKKOS_<part> of <parts> is unset unless the Kokkos run
# turns it on, WW_KOKKOS_ALL is 0 except in a Kokkos run whose <flags> has ALL, and the Kokkos run
# sets every counter of <counts>. The Kokkos run sets WW_KOKKOS_STRICT=1, so a part it asks for
# that would run the Fortran stops the run instead of comparing the Fortran with itself (PATCH.md
# section 24); the Fortran runs unset it. Every Kokkos
# run sets WW_KOKKOS_VA_POISON=1, the missed-sync detector (PATCH.md section 21), unless
# WW3GPU_VA_POISON is 0 (run_entry.cmake sets it from a caller's WW_KOKKOS_VA_POISON=0); the
# Fortran runs unset it. No run takes WW_KOKKOS_PRESET from the shell. The Fortran runs never
# inherit a flag from the shell.
function(ww3gpu_kokkos_env out k flags parts counts)
  set(e "")
  if(k STREQUAL "K" AND "ALL" IN_LIST flags)
    list(APPEND e "WW_KOKKOS_ALL=1")
  else()
    list(APPEND e "WW_KOKKOS_ALL=0")
  endif()
  if(k STREQUAL "K")
    list(APPEND e "WW_KOKKOS_STRICT=1")
  else()
    list(APPEND e "WW_KOKKOS_STRICT=")
  endif()
  if(k STREQUAL "K")
    if(DEFINED WW3GPU_VA_POISON AND WW3GPU_VA_POISON STREQUAL "0")
      list(APPEND e "WW_KOKKOS_VA_POISON=0")
    else()
      list(APPEND e "WW_KOKKOS_VA_POISON=1")
    endif()
  else()
    list(APPEND e "WW_KOKKOS_VA_POISON=")
  endif()
  list(APPEND e "WW_KOKKOS_PRESET=")
  foreach(p IN LISTS parts)
    if(k STREQUAL "K" AND p IN_LIST flags)
      list(APPEND e "WW_KOKKOS_${p}=1")
    else()
      list(APPEND e "WW_KOKKOS_${p}=")
    endif()
  endforeach()
  foreach(c IN LISTS counts)
    if(k STREQUAL "K")
      list(APPEND e "${c}=1")
    else()
      list(APPEND e "${c}=")
    endif()
  endforeach()
  set(${out} "${e}" PARENT_SCOPE)
endfunction()

# ww3gpu_parts_line_check(<out> <line> <flags>): the parts of <flags> that the W3INIT parts line
# ("Kokkos parts (K Kokkos, F Fortran): SNL1=K ... (n of m on Kokkos)", the fork's w3kokkosmd.F90)
# does not show on Kokkos, comma-separated, empty when all are; for ALL, "ALL" unless n > 0; "line"
# when there is no parts line.
function(ww3gpu_parts_line_check out line flags)
  if(NOT line MATCHES "Kokkos parts \\(K Kokkos, F Fortran\\):(.*)\\(([0-9]+) of [0-9]+ on Kokkos\\)")
    set(${out} line PARENT_SCOPE)
    return()
  endif()
  set(body " ${CMAKE_MATCH_1} ")
  set(non "${CMAKE_MATCH_2}")
  set(miss "")
  foreach(p IN LISTS flags)
    if(p STREQUAL "ALL")
      if(non EQUAL 0)
        list(APPEND miss ALL)
      endif()
    elseif(NOT body MATCHES " ${p}=K ")
      list(APPEND miss "${p}")
    endif()
  endforeach()
  list(JOIN miss "," miss)
  set(${out} "${miss}" PARENT_SCOPE)
endfunction()

# ww3gpu_switch_words(<out> <switch file> <words>): TRUE when the switch has every word of <words>
# and none of its !WORD entries; TRUE for an empty list.
function(ww3gpu_switch_words out file words)
  foreach(w IN LISTS words)
    if(w MATCHES "^!(.+)$")
      ww3gpu_has_word(h "${file}" "${CMAKE_MATCH_1}")
      if(h)
        set(${out} FALSE PARENT_SCOPE)
        return()
      endif()
    else()
      ww3gpu_has_word(h "${file}" "${w}")
      if(NOT h)
        set(${out} FALSE PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  set(${out} TRUE PARENT_SCOPE)
endfunction()

# ww3gpu_lab_switch(<out> <switch words> <lab switch words>): the entry's switch with its source-term
# words replaced by the lab switch's: every word of WW3's source-term categories (switches.json:
# stress FLXn, dstress FLDn, s_ln LNn and SEED, sterm STn, stab STABn, s_nl NLn, s_bot BTn, s_db
# DBn, miche MLIM, s_tr TRn, s_bs BSn, s_ice ICn, s_is ISn, reflection REFn). The lab switch's are the
# only set the Kokkos W3SRCE translates (W3KOKKOS_SRCE_SETUP's gate in the fork's w3kokkosmd.F90):
# the entry keeps its grid, forcing, propagation and outputs, and its physics becomes the timed run's.
function(ww3gpu_lab_switch out words lab)
  set(re "^((FLX|FLD|LN|ST|STAB|NL|BT|DB|TR|BS|IC|IS|REF)[0-9]+|MLIM|SEED)$")
  ww3gpu_words(w "${words}")
  ww3gpu_words(l "${lab}")
  set(r "")
  foreach(x IN LISTS w)
    if(NOT x MATCHES "${re}")
      list(APPEND r "${x}")
    endif()
  endforeach()
  foreach(x IN LISTS l)
    if(x MATCHES "${re}")
      list(APPEND r "${x}")
    endif()
  endforeach()
  list(JOIN r " " r)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ww3gpu_routine_word(<out> <routine>): the physics switch a routine of WW3GPU_ROUTINES needs,
# NL1 for SNL1, STn for SPRn, SINn and SDSn, ST6 for SWL6 (W3SWLDMD exists only with ST6), FLXn
# for FLXn; empty for any other name.
function(ww3gpu_routine_word out r)
  if(r STREQUAL "SNL1")
    set(${out} NL1 PARENT_SCOPE)
  elseif(r STREQUAL "SPR0")
    set(${out} ST0 PARENT_SCOPE)
  elseif(r MATCHES "^(SDS|SIN|SPR)([12346])$")
    set(${out} "ST${CMAKE_MATCH_2}" PARENT_SCOPE)
  elseif(r STREQUAL "SWL6")
    set(${out} ST6 PARENT_SCOPE)
  elseif(r MATCHES "^FLX[1-5]$")
    set(${out} "${r}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

# ww3gpu_routine_log(<out> <routine>): the regex of the line W3INIT writes when the routine's
# Kokkos path is on (the fork's w3initmd.F90 and W3KOKKOS_FLX_SETUP).
function(ww3gpu_routine_log out r)
  if(r STREQUAL "SNL1")
    set(${out} "Kokkos DIA \\(W3SNL1\\) enabled" PARENT_SCOPE)
  elseif(r MATCHES "^(SDS|SIN|SPR)4$")
    set(${out} "Kokkos ST4 \\(W3SDS4 W3SIN4 W3SPR4\\) enabled:.* ${r}=T" PARENT_SCOPE)
  elseif(r STREQUAL "SPR0")
    set(${out} "Kokkos ST0 \\(W3SPR0\\) enabled" PARENT_SCOPE)
  elseif(r MATCHES "^(SDS|SIN|SPR)([1236])$")
    set(n "${CMAKE_MATCH_2}")
    set(${out} "Kokkos ST${n} \\(W3SPR${n} W3SIN${n} W3SDS${n}\\) enabled:.* ${r}=T" PARENT_SCOPE)
  else()
    set(${out} "Kokkos W3${r} enabled" PARENT_SCOPE)
  endif()
endfunction()

# ww3gpu_physics(<out> <routines>): the physics switches of a routine list, sorted, no duplicate.
function(ww3gpu_physics out)
  set(w "")
  foreach(r IN LISTS ARGN)
    ww3gpu_routine_word(x "${r}")
    list(APPEND w ${x})
  endforeach()
  list(REMOVE_DUPLICATES w)
  list(SORT w)
  set(${out} "${w}" PARENT_SCOPE)
endfunction()

# ww3gpu_select_entries(<prefix> <matrix.base> <regtests dir> <serial|omp|mpi|all> [<physics>
# [<words>]]): every kept entry, in order, as two parallel lists <prefix>_TESTS and <prefix>_OPTS
# (the entry's options, $ww3 and the test dropped, space-joined; an entry with none is
# WW3GPU_NO_OPTS, since a CMake list cannot hold an empty first item, and ww3gpu_entry_opts reads
# it back as empty). <physics> is a list of switch
# words, NL1 by default, ANY for no physics filter; every entry whose switch has one of them and
# passes ww3gpu_switch_words on <words> is in exactly one of serial (none of MPI, OMPG, OMPH), omp
# (OMPG or OMPH, no MPI) and mpi (MPI); all is the three. A line whose switch file is missing is
# dropped, and so is a switch with both ST4 and FLX5, which KOKKOS refuses.
set(WW3GPU_NO_OPTS "<no-options>")

# ww3gpu_entry_opts(<out> <opts list> <i>): the options of entry <i> of a <prefix>_OPTS list of
# ww3gpu_select_entries, empty for an entry that has none.
function(ww3gpu_entry_opts out optl i)
  list(GET optl ${i} o)
  if(o STREQUAL "${WW3GPU_NO_OPTS}")
    set(o "")
  endif()
  set(${out} "${o}" PARENT_SCOPE)
endfunction()

function(ww3gpu_select_entries prefix base rt kind)
  set(phys "${ARGV4}")
  if(phys STREQUAL "")
    set(phys NL1)
  endif()
  set(words "")
  if(ARGC GREATER 5)
    set(words "${ARGV5}")
  endif()
  list(JOIN phys "|" phys)
  file(STRINGS "${base}" lines REGEX "echo \"\\$rtst .*\" *>> *matrix\\.body")
  set(tests "")
  set(optl "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^[ \t]*#")
      continue()
    endif()
    string(REGEX REPLACE ".*echo \"\\$rtst " "" s "${line}")
    string(REGEX REPLACE "\".*" "" s "${s}")
    ww3gpu_words(tok "${s}")
    list(LENGTH tok len)
    if(len LESS 2)
      continue()
    endif()
    list(POP_BACK tok test)
    list(GET tok -1 last)
    if("${last}" STREQUAL "$ww3")
      list(POP_BACK tok)
    endif()
    ww3gpu_opt_of(inp -i ${tok})
    ww3gpu_opt_of(sw -s ${tok})
    if(inp STREQUAL "")
      set(inp input)
    endif()
    set(f "${rt}/${test}/${inp}/switch")
    if(NOT sw STREQUAL "")
      string(APPEND f "_${sw}")
    endif()
    if(NOT EXISTS "${f}" OR IS_DIRECTORY "${f}")
      continue()
    endif()
    # KOKKOS with ST4 and FLX5 is refused at configure time by the fork (the Kokkos ST4 path does
    # not support FLX5, model/src/CMakeLists.txt at WW3@c9a6a0c6): neither run of such an entry
    # can build, whatever the routines.
    ww3gpu_has_word(st4 "${f}" "ST4")
    ww3gpu_has_word(flx5 "${f}" "FLX5")
    if(st4 AND flx5)
      continue()
    endif()
    if(phys STREQUAL "ANY")
      set(nl1 TRUE)
    else()
      ww3gpu_has_word(nl1 "${f}" "${phys}")
    endif()
    ww3gpu_switch_words(wok "${f}" "${words}")
    ww3gpu_has_word(mpi "${f}" "MPI")
    ww3gpu_has_word(omp "${f}" "OMPG|OMPH")
    if(NOT nl1 OR NOT wok)
      continue()
    endif()
    if(mpi)
      set(k mpi)
    elseif(omp)
      set(k omp)
    else()
      set(k serial)
    endif()
    if(NOT kind STREQUAL "all" AND NOT kind STREQUAL k)
      continue()
    endif()
    list(JOIN tok " " opts)
    if(opts STREQUAL "")
      set(opts "${WW3GPU_NO_OPTS}")
    endif()
    list(APPEND tests "${test}")
    list(APPEND optl "${opts}")
  endforeach()
  set(${prefix}_TESTS "${tests}" PARENT_SCOPE)
  set(${prefix}_OPTS "${optl}" PARENT_SCOPE)
endfunction()

# ww3gpu_sel_desc(<out> <serial|omp|mpi|all> [<physics>]): the selection rule, for the record's
# header; <physics> as in ww3gpu_select_entries, NL1 by default.
function(ww3gpu_sel_desc out kind)
  set(w "${ARGV2}")
  if(w STREQUAL "")
    set(w NL1)
  endif()
  list(JOIN w " or " w)
  if(ARGC GREATER 3 AND NOT "${ARGV3}" STREQUAL "")
    list(JOIN ARGV3 " " ws)
    if(w STREQUAL "ANY")
      set(w "the words ${ws}")
    else()
      string(APPEND w " and the words ${ws}")
    endif()
  elseif(w STREQUAL "ANY")
    set(w "any physics")
  endif()
  if(kind STREQUAL "omp")
    set(${out} "switch with ${w} and OMPG or OMPH, no MPI; $np = WW3GPU_OMP_THREADS" PARENT_SCOPE)
  elseif(kind STREQUAL "mpi")
    set(${out} "switch with ${w} and MPI; $mpi = mpirun, $np = $nr = WW3GPU_MPI_RANKS, $nth = WW3GPU_OMP_THREADS" PARENT_SCOPE)
  elseif(kind STREQUAL "all")
    set(${out} "every entry whose switch has ${w}" PARENT_SCOPE)
  else()
    set(${out} "switch with ${w}, none of MPI, OMPG, OMPH" PARENT_SCOPE)
  endif()
endfunction()

# ww3gpu_has_ounf(<out> <input dir>): the test post-processes to NetCDF (a ww3_ounf input).
function(ww3gpu_has_ounf out dir)
  file(GLOB g "${dir}/ww3_ounf*")
  if(g)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# ww3gpu_entry_args(<out> <n> <F|K> <test> <opts> <ww3> <threads> [<ranks>]): the run_cmake_test
# argument list of entry <n>'s run: its options without -s and -w, expanded by ww3gpu_expand ($np is
# <ranks> on an MPI line (-p), <threads> otherwise), -o netcdf when it has no -o and its input
# directory has a ww3_ounf input, then -s <sw>_KOKKOS -w work_<F|K>_<n> <ww3>/model <test>.
function(ww3gpu_entry_args out n kind test opts ww3 threads)
  set(ranks "${ARGV7}")
  if(ranks STREQUAL "")
    set(ranks 4)
  endif()
  ww3gpu_words(o "${opts}")
  if("-p" IN_LIST o)
    set(np "${ranks}")
  else()
    set(np "${threads}")
  endif()
  ww3gpu_expand(opts "${opts}" "${np}" "${ranks}" "${threads}")
  ww3gpu_words(o "${opts}")
  ww3gpu_opt_of(sw -s ${o})
  ww3gpu_opt_of(inp -i ${o})
  ww3gpu_opt_of(oo -o ${o})
  set(keep "")
  set(prev "")
  foreach(f IN LISTS o)
    if(f STREQUAL "-s" OR f STREQUAL "-w")
      set(prev "${f}")
      continue()
    endif()
    if(NOT prev STREQUAL "-s" AND NOT prev STREQUAL "-w")
      list(APPEND keep "${f}")
    endif()
    set(prev "${f}")
  endforeach()
  if(inp STREQUAL "")
    set(inp input)
  endif()
  if(oo STREQUAL "")
    ww3gpu_has_ounf(ounf "${ww3}/regtests/${test}/${inp}")
    if(ounf)
      list(APPEND keep -o netcdf)
    endif()
  endif()
  if(sw STREQUAL "")
    set(ks KOKKOS)
  else()
    set(ks "${sw}_KOKKOS")
  endif()
  list(APPEND keep -s "${ks}" -w "work_${kind}_${n}" "${ww3}/model" "${test}")
  set(${out} "${keep}" PARENT_SCOPE)
endfunction()

# ww3gpu_row_verdict(<out> <row> <strict>): the failures of one summary row, empty when it passes.
# A failure: nccmp-tol FAIL or MISSING; either run did not finish, so nothing was compared; the
# Kokkos run without the W3INIT log line of a selected routine its switch builds ("Kokkos DIA
# (W3SNL1) enabled.", "Kokkos ST4 (...) enabled: ... SDS4=T"); under <strict>, a file test.comp found
# different Fortran/Kokkos and identical Fortran/Fortran (run_entry.cmake). A row whose Kokkos
# run computed no spectrum (kokkos_spectra 0, or <R>:0 for a routine: the grid calls GQM,
# IQTYPE <= 0) passes, and the record says it did not exercise that routine.
function(ww3gpu_row_verdict out row strict)
  string(REPLACE "\t" ";" c "${row}")
  list(GET c 4 ran)
  list(GET c 5 klog)
  list(GET c 6 tc)
  list(GET c 7 nv)
  set(why "")
  if(nv STREQUAL "FAIL" OR nv STREQUAL "MISSING")
    list(APPEND why "nccmp-tol ${nv}")
  endif()
  if(ran STREQUAL "fortran-only")
    list(APPEND why "the Kokkos run did not finish")
  elseif(ran STREQUAL "kokkos-only")
    list(APPEND why "the Fortran run did not finish")
  elseif(ran STREQUAL "no")
    list(APPEND why "neither run finished")
  endif()
  if(ran STREQUAL "yes" AND NOT klog STREQUAL "yes")
    list(APPEND why "no Kokkos log line of a selected routine in the Kokkos run")
  endif()
  if(strict AND tc MATCHES "^([0-9]+)/" AND NOT CMAKE_MATCH_1 EQUAL 0)
    list(APPEND why "test.comp: ${tc} files differ (WW3GPU_STRICT)")
  endif()
  list(JOIN why "; " why)
  set(${out} "${why}" PARENT_SCOPE)
endfunction()

# ww3gpu_judged_vars(<out> <nccmp-tol output>): the variables it judged, comma-separated.
function(ww3gpu_judged_vars out text)
  string(REPLACE ";" "," text "${text}")
  string(REPLACE "\n" ";" lines "${text}")
  set(p FALSE)
  set(v "")
  foreach(l IN LISTS lines)
    if(p)
      ww3gpu_words(w "${l}")
      if(w)
        list(GET w 0 first)
        list(GET w -1 lastw)
        if(NOT first STREQUAL "nccmp-tol:" AND NOT lastw STREQUAL "unlisted")
          list(APPEND v "${first}")
        endif()
      endif()
    endif()
    if(l MATCHES "^-+$")
      set(p TRUE)
    endif()
  endforeach()
  list(JOIN v "," v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# ww3gpu_ftp_version(<ver> <url> <ww3_from_ftp.sh>): the data version and the tarball URL it names.
function(ww3gpu_ftp_version ver url script)
  file(STRINGS "${script}" vl REGEX "^ww3ver=")
  list(GET vl 0 vl)
  string(REGEX REPLACE "^ww3ver=" "" v "${vl}")
  file(STRINGS "${script}" ul REGEX "https://ftp\\.emc\\.ncep\\.noaa\\.gov/")
  set(u "")
  if(ul)
    list(GET ul 0 ul)
    string(REGEX MATCH "https://ftp\\.emc\\.ncep\\.noaa\\.gov/[^ \t]*" u "${ul}")
    string(REPLACE "\${ww3ver}" "${v}" u "${u}")
  endif()
  set(${ver} "${v}" PARENT_SCOPE)
  set(${url} "${u}" PARENT_SCOPE)
endfunction()

# ww3gpu_ftp_copies(<prefix> <ww3_from_ftp.sh>): <prefix>_SRC and <prefix>_DST, the parallel lists
# of every `cp -r data_regtests/<src> regtests/<dst>` line (commented lines excluded).
function(ww3gpu_ftp_copies prefix script)
  file(STRINGS "${script}" lines REGEX "^[ \t]*cp -r data_regtests/")
  set(src "")
  set(dst "")
  foreach(l IN LISTS lines)
    if(l MATCHES "^[ \t]*cp -r data_regtests/([^ \t]+)[ \t]+regtests/([^ \t]+)[ \t]*$")
      list(APPEND src "${CMAKE_MATCH_1}")
      list(APPEND dst "${CMAKE_MATCH_2}")
    endif()
  endforeach()
  set(${prefix}_SRC "${src}" PARENT_SCOPE)
  set(${prefix}_DST "${dst}" PARENT_SCOPE)
endfunction()

# ww3gpu_stage_data(<out count> <cache data_regtests> <stage> <test> <ww3_from_ftp.sh>): copy what
# the script's cp lines copy into regtests/<test>/, for that test only; <out> is the number of
# sources copied, or -1 (nothing copied) when the test needs the data and the cache is missing.
function(ww3gpu_stage_data out cache st test script)
  ww3gpu_ftp_copies(cp "${script}")
  set(n 0)
  set(i 0)
  foreach(src IN LISTS cp_SRC)
    list(GET cp_DST ${i} dst)
    math(EXPR i "${i} + 1")
    string(REGEX REPLACE "/.*" "" top "${dst}")
    if(NOT top STREQUAL test)
      continue()
    endif()
    if(NOT IS_DIRECTORY "${cache}")
      set(${out} -1 PARENT_SCOPE)
      return()
    endif()
    set(to "${st}/${dst}")
    if(dst MATCHES "/$")
      file(MAKE_DIRECTORY "${to}")
    else()
      get_filename_component(d "${to}" DIRECTORY)
      file(MAKE_DIRECTORY "${d}")
    endif()
    file(GLOB fs LIST_DIRECTORIES true "${cache}/${src}")
    foreach(f IN LISTS fs)
      if(IS_DIRECTORY "${to}")
        file(COPY "${f}" DESTINATION "${to}")
      elseif(IS_DIRECTORY "${f}")
        file(COPY "${f}/" DESTINATION "${to}")
      else()
        file(COPY_FILE "${f}" "${to}")
      endif()
      math(EXPR n "${n} + 1")
    endforeach()
  endforeach()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

# A CUDA matrix runs on the GPU, which needs the owner watching (AGENTS.md, "Running on the GPU").
# `just ww3-gpu-matrix-cuda` asks for a typed "yes" (scripts/gpu_supervised.sh) and sets
# WW3GPU_GPU_CONFIRMED=1 for its own ctest only; a ctest started any other way stops here, in
# setup:kokkos and in every entry. Never set it by hand.
function(ww3gpu_require_gpu_confirmation)
  if(WW3GPU_BACKEND STREQUAL "cuda" AND NOT "$ENV{WW3GPU_GPU_CONFIRMED}" STREQUAL "1")
    message(FATAL_ERROR "ww3gpu_matrix: this build runs Kokkos on the GPU; start it with `just ww3-gpu-matrix-cuda`, which asks the supervising human first")
  endif()
endfunction()
