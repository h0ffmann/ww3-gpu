# setup:stage: copy every selected test out of WW3/ into <build>/regtests/<test>/, with the ftp
# data ww3_from_ftp.sh would copy into it, write switch_<s>_KOKKOS (the entry's switch plus
# KOKKOS) beside each original, and clear the rows of the previous run. WW3/ is only read.
cmake_minimum_required(VERSION 3.21)
include("${CONFIG}")
include("${CMAKE_CURRENT_LIST_DIR}/ww3gpu_common.cmake")
ww3gpu_select_entries(E "${WW3GPU_WW3}/regtests/bin/matrix.base" "${WW3GPU_WW3}/regtests" "${WW3GPU_SELECTION}" "${WW3GPU_PHYSICS}")
file(REMOVE_RECURSE "${WW3GPU_OUT}/rows")
file(MAKE_DIRECTORY "${WW3GPU_STAGE}" "${WW3GPU_OUT}/rows" "${WW3GPU_OUT}/logs")

set(tests ${E_TESTS})
list(REMOVE_DUPLICATES tests)
foreach(test IN LISTS tests)
  file(COPY "${WW3GPU_WW3}/regtests/${test}/" DESTINATION "${WW3GPU_STAGE}/${test}")
  ww3gpu_stage_data(n "${WW3GPU_DATA}/data_regtests" "${WW3GPU_STAGE}" "${test}" "${WW3GPU_WW3}/model/bin/ww3_from_ftp.sh")
  if(n EQUAL -1)
    message(WARNING "${test} needs WW3's ftp data (ww3_from_ftp.sh), and ${WW3GPU_DATA}/data_regtests is missing: run `just ww3-gpu-matrix-fetch`, or pass -DWW3GPU_DATA")
  elseif(n GREATER 0)
    message(STATUS "${test}: ${n} file(s) of WW3's ftp data staged")
  endif()
endforeach()

set(i 0)
foreach(test IN LISTS E_TESTS)
  list(GET E_OPTS ${i} opts)
  math(EXPR i "${i} + 1")
  ww3gpu_words(o "${opts}")
  ww3gpu_opt_of(inp -i ${o})
  ww3gpu_opt_of(sw -s ${o})
  if(inp STREQUAL "")
    set(inp input)
  endif()
  set(d "${WW3GPU_STAGE}/${test}/${inp}")
  if(sw STREQUAL "")
    set(from "${d}/switch")
    set(to "${d}/switch_KOKKOS")
  else()
    set(from "${d}/switch_${sw}")
    set(to "${d}/switch_${sw}_KOKKOS")
  endif()
  file(READ "${from}" s)
  string(REGEX REPLACE "[ \n]+" " " s "${s}")
  string(REGEX REPLACE " +$" "" s "${s}")
  file(WRITE "${to}" "${s} KOKKOS\n")
endforeach()
list(LENGTH tests nt)
message(STATUS "staged ${nt} test(s), ${i} KOKKOS switch(es), in ${WW3GPU_STAGE}")
