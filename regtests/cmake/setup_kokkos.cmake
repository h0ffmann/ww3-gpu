# setup:kokkos: build and install the openmp-release package of kokkos/ (ww_kokkos and
# nccmp-tol), which every entry's KOKKOS build finds through CMAKE_PREFIX_PATH.
cmake_minimum_required(VERSION 3.21)
include("${CONFIG}")
cmake_host_system_information(RESULT ncpu QUERY NUMBER_OF_LOGICAL_CORES)
# Reconfigured from scratch when the toolchain changed (scripts/hoff.sh keeps the same stamp).
find_program(_gf gfortran)
find_program(_cxx c++)
file(REAL_PATH "${_gf}" _gf)
file(REAL_PATH "${_cxx}" _cxx)
set(_tc "${_gf} ${_cxx} $ENV{CMAKE_PREFIX_PATH}")
set(_old "")
if(EXISTS "${HOFF_KBUILD}/toolchain")
  file(READ "${HOFF_KBUILD}/toolchain" _old)
  string(STRIP "${_old}" _old)
endif()
if(IS_DIRECTORY "${HOFF_KBUILD}" AND NOT _old STREQUAL _tc)
  file(REMOVE_RECURSE "${HOFF_KBUILD}")
endif()
file(MAKE_DIRECTORY "${HOFF_KBUILD}")
file(WRITE "${HOFF_KBUILD}/toolchain" "${_tc}\n")
if(NOT EXISTS "${HOFF_KBUILD}/CMakeCache.txt")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${HOFF_ROOT}/kokkos" --preset openmp-release
                  WORKING_DIRECTORY "${HOFF_ROOT}/kokkos" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${HOFF_KBUILD}" -j ${ncpu} OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${HOFF_KBUILD}" --prefix "${HOFF_KPREFIX}" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
if(NOT EXISTS "${HOFF_NCCMP}")
  message(FATAL_ERROR "hoff_matrix: no ${HOFF_NCCMP} after the build")
endif()
message(STATUS "ww_kokkos (openmp-release) installed in ${HOFF_KPREFIX}")
